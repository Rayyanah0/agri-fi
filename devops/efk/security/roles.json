      "indices": [
        {
          "names": ["agri-fi-*"],
          "privileges": ["all"]
        }
      ],
      "applications": [
        {
          "application": "kibana-.kibana",
          "privileges": [
            "feature_dashboard.all",
            "feature_discover.all",
            "feature_visualize.all",
            "feature_logs.all",
            "feature_actions.all",
            "feature_stackAlerts.all"
