      "indices": [
        {
          "names": ["agri-fi-*"],
          "privileges": ["create_index", "index", "create", "write", "view_index_metadata"]
        }
      ]
    }
  },
  {
    "name": "agri_fi_logs_viewer",
    "body": {
      "cluster": ["monitor"],
      "indices": [
        {
          "names": ["agri-fi-*"],
          "privileges": ["read", "view_index_metadata"]
        }
      ],
      "applications": [
        {
          "application": "kibana-.kibana",
          "privileges": [
            "feature_dashboard.read",
            "feature_discover.read",
