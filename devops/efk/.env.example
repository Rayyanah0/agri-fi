# Agri-Fi centralised logging (EFK) environment (#1236).
# Copy to `.env` next to devops/efk/docker-compose.yml and adjust.

# Enable Elasticsearch/Kibana security (TLS + authentication + RBAC).
# When false, the stack runs unauthenticated (local development only).
XPACK_SECURITY_ENABLED=false

# Password for the built-in `elastic` superuser and service accounts.
ELASTIC_PASSWORD=changeme

# Kibana uses the built-in `kibana_system` service account.
KIBANA_ELASTICSEARCH_USERNAME=kibana_system

# Kibana encryption keys (must each be >= 32 characters).
KIBANA_ENCRYPTION_KEY=agri-fi-dashboard-encryption-key-32ch
KIBANA_REPORTING_KEY=agri-fi-reporting-encryption-key-32ch
KIBANA_SECURITY_KEY=agri-fi-security-encryption-key-32ch

# Log shipping (leave blank when security is disabled).
LOG_ENVIRONMENT=development
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
